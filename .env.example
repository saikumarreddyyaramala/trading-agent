# Copy this file to .env and fill in your values. Never commit .env.
# For live trading, keep live keys in a separate file (e.g. .env.live) and select it
# with ENV_FILE=.env.live. Both files are git-ignored.
# In cloud deployments these come from a secrets manager instead of a file.

# Which config/<env>.yaml to load: paper | live
APP_ENV=paper

# Alpaca (use your PAPER trading keys while APP_ENV=paper)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# LLM provider keys: only the one selected in config/base.yaml (llm.provider) is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Audit database (optional for paper, required for live). Examples:
#   docker compose:  postgresql://trading:trading@localhost:5432/trading
#   no Docker:       sqlite:///data/audit.db
DATABASE_URL=

# Optional: post the daily report to a Slack-compatible incoming webhook
REPORT_WEBHOOK_URL=

# Optional: phone alerts through Telegram. Create a bot with @BotFather, paste its token,
# send the bot a message, then run `trading-agent alerts-setup` to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Second, deliberate switch required before any live (real-money) order
LIVE_TRADING_CONFIRMED=false

# Logging: console (human-readable) or json (for log platforms)
LOG_LEVEL=INFO
LOG_FORMAT=console
